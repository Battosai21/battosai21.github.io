<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ basics.name }} — {{ basics.label }}</title>
<meta name="description" content="{{ basics.summary }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #10161d;
    --surface: #171f28;
    --rule: #2a3540;
    --amber: #e7a33d;
    --amber-dim: #8a662a;
    --text: #e9edf1;
    --text-muted: #8e99a4;
    --max-width: 980px;
    --nav-h: 52px;
  }

  @media (min-width: 1200px) {
    :root { --max-width: 1300px; }
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-snap-type: y proximity; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.6;
    font-size: 16px;
  }

  ::selection { background: var(--amber); color: #10161d; }
  a { color: var(--text); }

  .wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 24px; }
  .wrap-narrow { max-width: 760px; margin: 0 auto; padding: 0 24px; }

  /* Header */
  header.masthead { padding: 56px 0 28px; scroll-snap-align: none; }

  .masthead-grid {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
    padding: 0 24px;
  }

  .photo-frame { position: relative; width: 108px; height: 108px; flex-shrink: 0; }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(35%); }
  .photo-frame::before, .photo-frame::after { content: ""; position: absolute; width: 16px; height: 16px; border: 2px solid var(--amber); }
  .photo-frame::before { top: -6px; left: -6px; border-right: none; border-bottom: none; }
  .photo-frame::after { bottom: -6px; right: -6px; border-left: none; border-top: none; }

  .callsign { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--amber); margin-bottom: 14px; }

  h1.name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.08;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .role { font-size: 1.02rem; color: var(--text-muted); max-width: 46ch; white-space: pre-line; }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .meta-row a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .meta-row a:hover { border-color: var(--amber); color: var(--amber); }

  .resume-jump { color: var(--amber) !important; border-color: var(--amber-dim) !important; font-weight: 500; }

  /* Timeline nav */
  .timeline-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(16, 22, 29, 0.92);
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .timeline-track {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .timeline-track::-webkit-scrollbar { display: none; }

  .timeline-track button {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    padding: 14px 12px;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .timeline-track button:hover { color: var(--text); }
  .timeline-track button.active { color: var(--amber); border-bottom-color: var(--amber); }

  /* Intro */
  .intro {
    padding: 40px 20px 44px;
    margin-bottom: 8px;
    border-top: 1px dashed var(--rule);
    border-bottom: 1px dashed var(--rule);
    scroll-snap-align: none;
  }
  .intro p {
    font-size: 1.08rem;
    color: var(--text-muted);
    max-width: 58ch;
    text-align: justify;
    text-justify: inter-word;
    white-space: pre-line;
  }

  /* Chapters — one per screen, alternating sides */
  .chapter {
    min-height: calc(100dvh - var(--nav-h));
    display: flex;
    align-items: center;
    border-bottom: 1px dashed var(--rule);
    scroll-snap-align: start;
    scroll-margin-top: var(--nav-h);
    padding: 48px 0;
    white-space: pre-line;
  }
  .chapter:last-of-type { border-bottom: none; }

  .chapter-inner {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 56px;
    text-align: justify;
    text-justify: inter-word;
  }

  /* Alternate sides on even chapters */
  .chapter:nth-of-type(even) .chapter-inner { flex-direction: row-reverse; }

  .chapter-text { flex: 1 1 0; min-width: 0; }
  .chapter-media { flex: 1 1 0; min-width: 0; }

  .chapter-year {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    color: var(--amber);
    margin-bottom: 8px;
  }

  .chapter-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0 0 14px;
  }

  .chapter-body { color: var(--text-muted); font-size: 1.02rem; }

  /* Photo fan */
  .photo-fan {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fan-photo {
  position: absolute;
  max-width: 70%;
  max-height: 85%;
  border: 1px solid var(--rule);
  background: var(--surface);
  padding: 0;
  overflow: hidden;
  cursor: pointer;
  line-height: 0;
  box-shadow: 0 12px 28px rgba(0,0,0,0.35);
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease, box-shadow 0.4s ease;
  transform: rotate(var(--fan-rot, 0deg)) translateX(var(--fan-x, 0px));
  z-index: var(--fan-z, 1);
}

  .fan-photo img { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; filter: grayscale(55%); transition: filter 0.4s ease; }
  .fan-photo:hover { filter: none; }
  .fan-photo:hover img { filter: grayscale(20%); }

  .fan-photo.active {
    transform: rotate(0deg) translateX(0);
    z-index: 10;
    box-shadow: 0 18px 40px rgba(0,0,0,0.5);
    cursor: default;
  }
  .fan-photo.active img { filter: none; }

  .fan-photo:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox.open { opacity: 1; pointer-events: auto; }

  .lightbox img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 0.2s ease;
    cursor: zoom-in;
    touch-action: none;
    user-select: none;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 10;
    background: none;
    border: 1px solid var(--rule);
    color: var(--text);
    font-size: 28px;
    line-height: 1;
    width: 44px;
    height: 44px;
    border-radius: 4px;
    cursor: pointer;
  }
  .lightbox-close:hover { border-color: var(--amber); color: var(--amber); }

  .lightbox-controls {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 8px;
  }
  .lightbox-controls button {
    background: rgba(23, 31, 40, 0.9);
    border: 1px solid var(--rule);
    color: var(--text);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 18px;
    width: 40px;
    height: 40px;
    border-radius: 4px;
    cursor: pointer;
  }
  .lightbox-controls button:hover { border-color: var(--amber); color: var(--amber); }

  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox img { transition: none; }
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .reveal.is-visible { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; scroll-snap-type: none; }
    .fan-photo { transition: filter 0.3s ease; }
  }

  footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 60px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    scroll-snap-align: none;
  }
  footer a { color: var(--amber); text-decoration: none; }

  @media (max-width: 760px) {
    .chapter { min-height: 0; padding: 40px 0; }
    .chapter-inner,
    .chapter:nth-of-type(even) .chapter-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }
    .chapter-media { order: -1; }
    .fan-photo { width: 82%; }
    header.masthead { padding-top: 36px; }
  }

  a:focus-visible, button:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-grid">
    <div>
      <div class="callsign">{{ basics.location.city }}, {{ basics.location.country }}</div>
      <h1 class="name">{{ basics.name }}</h1>
      <p class="role">{{ basics.label }}</p>
      <div class="meta-row">
        <a href="resume.html" class="resume-jump">Jump to résumé →</a>
        {% if basics.email %}<a href="mailto:{{ basics.email }}">{{ basics.email }}</a>{% endif %}
        {% for p in basics.profiles %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.network }}</a>{% endfor %}
      </div>
    </div>
    {% if basics.image %}
    <div class="photo-frame"><img src="{{ basics.image }}" alt="{{ basics.name }}"></div>
    {% endif %}
  </div>
</header>

<nav class="timeline-nav">
  <div class="timeline-track">
    {% for ch in chapters %}
    <button data-target="year-{{ ch.year }}">{{ ch.year }}</button>
    {% endfor %}
  </div>
</nav>

{% if intro %}
<section class="intro reveal wrap-narrow">
  <p>{{ intro }}</p>
</section>
{% endif %}

<main>
  {% for ch in chapters %}
  <section class="chapter reveal" id="year-{{ ch.year }}" data-year="year-{{ ch.year }}">
    <div class="wrap">
      <div class="chapter-inner">
        <div class="chapter-text">
          <div class="chapter-year">{{ ch.year }}</div>
          <h2 class="chapter-title">{{ ch.title }}</h2>
          <p class="chapter-body">{{ ch.text }}</p>
        </div>
        {% if ch.images %}
        <div class="chapter-media">
          <div class="photo-fan">
            {% for img, f in zip(ch.images, ch.fan) %}
            <button
              class="fan-photo{% if loop.first %} active{% endif %}"
              style="--fan-rot: {{ f.rot }}deg; --fan-x: {{ f.x }}px; --fan-z: {{ f.z }};"
              aria-label="View photo {{ loop.index }} of {{ ch.images|length }} for {{ ch.year }}"
              {% if ch.images|length == 1 %}tabindex="-1"{% endif %}
            >
              <img src="{{ img }}" alt="{{ ch.title }} — photo {{ loop.index }}" loading="lazy">
            </button>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endfor %}
</main>

<footer>
  Prefer the short version? <a href="resume.html">View my résumé →</a>
</footer>

<div id="lightbox" class="lightbox" aria-hidden="true">
  <button class="lightbox-close" aria-label="Close">&times;</button>
  <div class="lightbox-controls">
    <button class="lightbox-zoom-out" aria-label="Zoom out">−</button>
    <button class="lightbox-zoom-in" aria-label="Zoom in">+</button>
  </div>
  <img id="lightbox-img" src="" alt="">
</div>

<script>
(function () {
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var navEl = document.querySelector('.timeline-nav');
  var chapters = Array.prototype.slice.call(document.querySelectorAll('.chapter'));
  var revealEls = document.querySelectorAll('.reveal');
  var navButtons = document.querySelectorAll('.timeline-track button');
  var track = document.querySelector('.timeline-track');

  function setNavHeight() {
    if (navEl) document.documentElement.style.setProperty('--nav-h', navEl.offsetHeight + 'px');
  }
  setNavHeight();
  window.addEventListener('resize', setNavHeight);

  // Active year highlight
  function setActiveNav(id) {
    navButtons.forEach(function (btn) {
      var isActive = btn.dataset.target === id;
      btn.classList.toggle('active', isActive);
      if (isActive && track) {
        var btnRect = btn.getBoundingClientRect();
        var trackRect = track.getBoundingClientRect();
        track.scrollLeft += (btnRect.left - trackRect.left) - trackRect.width / 2 + btnRect.width / 2;
      }
    });
  }

  // Click-to-jump on timeline
  var isProgrammaticScroll = false;

  function waitForScrollSettle(cb) {
    var lastY = window.scrollY;
    var stableFrames = 0;
    function check() {
      var y = window.scrollY;
      if (Math.abs(y - lastY) < 1) {
        stableFrames++;
      } else {
        stableFrames = 0;
      }
      lastY = y;
      if (stableFrames > 6) { cb(); return; }
      requestAnimationFrame(check);
    }
    requestAnimationFrame(check);
  }

  navButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      isProgrammaticScroll = true;
      setActiveNav(btn.dataset.target);
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      waitForScrollSettle(function () { isProgrammaticScroll = false; });
    });
  });

  // Fan photo picker
  document.querySelectorAll('.photo-fan').forEach(function (fan) {
    var photos = fan.querySelectorAll('.fan-photo');
    if (photos.length <= 1) return;
    photos.forEach(function (photo) {
      photo.addEventListener('click', function () {
        photos.forEach(function (p) { p.classList.remove('active'); p.tabIndex = 0; });
        photo.classList.add('active');
      });
    });
  });

  // Active-year tracking: checks actual chapter positions on every scroll
  // frame instead of relying on intersection-threshold events, so a fast
  // scroll can never skip over a chapter without it being detected.
  var scrollTicking = false;

  function updateActiveFromScroll() {
    if (isProgrammaticScroll || !chapters.length) return;
    var navH = navEl ? navEl.offsetHeight : 0;
    var refY = navH + 4;
    var current = chapters[0];
    for (var i = 0; i < chapters.length; i++) {
      if (chapters[i].getBoundingClientRect().top <= refY) {
        current = chapters[i];
      } else {
        break;
      }
    }
    setActiveNav(current.dataset.year);
  }

  window.addEventListener('scroll', function () {
    if (!scrollTicking) {
      scrollTicking = true;
      requestAnimationFrame(function () {
        updateActiveFromScroll();
        scrollTicking = false;
      });
    }
  }, { passive: true });

  updateActiveFromScroll();

  // Fade-in reveal
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
    return;
  }

  var revealObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
  revealEls.forEach(function (el) { revealObserver.observe(el); });
})();

// Lightbox
(function () {
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var closeBtn = document.querySelector('.lightbox-close');
  var zoomInBtn = document.querySelector('.lightbox-zoom-in');
  var zoomOutBtn = document.querySelector('.lightbox-zoom-out');

  var scale = 1, panX = 0, panY = 0;
  var MIN_SCALE = 1, MAX_SCALE = 4;

  // Track which photo-set is open, so arrow keys know what "next" means
  var currentPhotos = [];
  var currentIndex = 0;

  function applyTransform() {
    lightboxImg.style.transform = 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
    lightboxImg.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
  }

  function resetZoom() {
    scale = 1; panX = 0; panY = 0;
    applyTransform();
  }

  function clampScale(s) {
    return Math.min(MAX_SCALE, Math.max(MIN_SCALE, s));
  }

  function showIndex(i) {
    currentIndex = (i + currentPhotos.length) % currentPhotos.length;
    var photo = currentPhotos[currentIndex];
    var img = photo.querySelector('img');
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    resetZoom();
    // keep the fan in sync, so closing the lightbox leaves the same photo in front
    currentPhotos.forEach(function (p) { p.classList.remove('active'); p.tabIndex = 0; });
    photo.classList.add('active');
  }

  function openLightbox(photos, index) {
    currentPhotos = photos;
    showIndex(index);
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    resetZoom();
  }

  // Wire up fan photos: click the FRONT (active) photo opens the lightbox;
  // clicking any other photo just brings it to the front, same as before.
  document.querySelectorAll('.photo-fan').forEach(function (fan) {
    var photos = Array.prototype.slice.call(fan.querySelectorAll('.fan-photo'));
    photos.forEach(function (photo, idx) {
      photo.addEventListener('click', function () {
        var isFront = photo.classList.contains('active');
        if (isFront || photos.length === 1) {
          openLightbox(photos, idx);
          return;
        }
        photos.forEach(function (p) { p.classList.remove('active'); p.tabIndex = 0; });
        photo.classList.add('active');
      });
    });
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', function (e) {
    if (!lightbox.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight' && currentPhotos.length > 1) showIndex(currentIndex + 1);
    if (e.key === 'ArrowLeft' && currentPhotos.length > 1) showIndex(currentIndex - 1);
  });

  zoomInBtn.addEventListener('click', function () { scale = clampScale(scale + 0.5); applyTransform(); });
  zoomOutBtn.addEventListener('click', function () { scale = clampScale(scale - 0.5); applyTransform(); });

  // Wheel to zoom
  lightboxImg.addEventListener('wheel', function (e) {
    e.preventDefault();
    scale = clampScale(scale + (e.deltaY < 0 ? 0.25 : -0.25));
    if (scale === 1) { panX = 0; panY = 0; }
    applyTransform();
  }, { passive: false });

  // Double-click / double-tap to toggle zoom
  lightboxImg.addEventListener('dblclick', function () {
    if (scale > 1) { resetZoom(); } else { scale = 2.5; applyTransform(); }
  });

  // Prevent the browser's native "drag this image out" behavior, which was
  // hijacking the pointer gesture and making drag feel like a text/image
  // selection instead of a pan.
  lightboxImg.setAttribute('draggable', 'false');
  lightboxImg.addEventListener('dragstart', function (e) { e.preventDefault(); });

  // Drag to pan when zoomed
  var dragging = false, startX, startY, startPanX, startPanY;
  lightboxImg.addEventListener('pointerdown', function (e) {
    if (scale <= 1) return;
    dragging = true;
    startX = e.clientX; startY = e.clientY;
    startPanX = panX; startPanY = panY;
    lightboxImg.setPointerCapture(e.pointerId);
    lightboxImg.style.cursor = 'grabbing';
  });
  lightboxImg.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    panX = startPanX + (e.clientX - startX);
    panY = startPanY + (e.clientY - startY);
    applyTransform();
  });
  ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (evt) {
    lightboxImg.addEventListener(evt, function () {
      dragging = false;
      if (scale > 1) lightboxImg.style.cursor = 'grab';
    });
  });

  // Pinch-to-zoom on touch
  var pinchStartDist = null, pinchStartScale = 1;
  lightboxImg.addEventListener('touchstart', function (e) {
    if (e.touches.length === 2) {
      pinchStartDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      pinchStartScale = scale;
    }
  }, { passive: true });
  lightboxImg.addEventListener('touchmove', function (e) {
    if (e.touches.length === 2 && pinchStartDist) {
      e.preventDefault();
      var dist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY
      );
      scale = clampScale(pinchStartScale * (dist / pinchStartDist));
      applyTransform();
    }
  }, { passive: false });
  lightboxImg.addEventListener('touchend', function (e) {
    if (e.touches.length < 2) pinchStartDist = null;
  });
})();

</script>

</body>
</html>
