<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ basics.name }} — {{ basics.label }}</title>
<meta name="description" content="{{ basics.summary }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #10161d;
    --surface: #171f28;
    --rule: #2a3540;
    --amber: #e7a33d;
    --amber-dim: #8a662a;
    --text: #e9edf1;
    --text-muted: #8e99a4;
    --max-width: 980px;
    --nav-h: 52px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-snap-type: y proximity; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.6;
    font-size: 16px;
  }

  ::selection { background: var(--amber); color: #10161d; }
  a { color: var(--text); }

  .wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 24px; }
  .wrap-narrow { max-width: 760px; margin: 0 auto; padding: 0 24px; }

  /* Header */
  header.masthead { padding: 56px 0 28px; scroll-snap-align: none; }

  .masthead-grid {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
    padding: 0 24px;
  }

  .photo-frame { position: relative; width: 108px; height: 108px; flex-shrink: 0; }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(35%); }
  .photo-frame::before, .photo-frame::after { content: ""; position: absolute; width: 16px; height: 16px; border: 2px solid var(--amber); }
  .photo-frame::before { top: -6px; left: -6px; border-right: none; border-bottom: none; }
  .photo-frame::after { bottom: -6px; right: -6px; border-left: none; border-top: none; }

  .callsign { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--amber); margin-bottom: 14px; }

  h1.name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.08;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .role { font-size: 1.02rem; color: var(--text-muted); max-width: 46ch; }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .meta-row a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .meta-row a:hover { border-color: var(--amber); color: var(--amber); }

  .resume-jump { color: var(--amber) !important; border-color: var(--amber-dim) !important; font-weight: 500; }

  /* Timeline nav */
  .timeline-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(16, 22, 29, 0.92);
    backdrop-filter: blur(6px);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .timeline-track {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .timeline-track::-webkit-scrollbar { display: none; }

  .timeline-track button {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    padding: 14px 12px;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .timeline-track button:hover { color: var(--text); }
  .timeline-track button.active { color: var(--amber); border-bottom-color: var(--amber); }

  /* Intro */
  .intro { padding: 40px 0 8px; scroll-snap-align: none; }
  .intro p { font-size: 1.08rem; color: var(--text-muted); max-width: 58ch; }

  /* Chapters — one per screen, alternating sides */
  .chapter {
    min-height: calc(100dvh - var(--nav-h));
    display: flex;
    align-items: center;
    border-bottom: 1px dashed var(--rule);
    scroll-snap-align: start;
    scroll-margin-top: var(--nav-h);
    padding: 48px 0;
  }
  .chapter:last-of-type { border-bottom: none; }

  .chapter-inner {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 56px;
  }

  /* Alternate sides on even chapters */
  .chapter:nth-of-type(even) .chapter-inner { flex-direction: row-reverse; }

  .chapter-text { flex: 1 1 0; min-width: 0; }
  .chapter-media { flex: 1 1 0; min-width: 0; }

  .chapter-year {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2rem;
    color: var(--amber);
    margin-bottom: 8px;
  }

  .chapter-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0 0 14px;
  }

  .chapter-body { color: var(--text-muted); font-size: 1.02rem; max-width: 50ch; }

  /* Photo fan */
  .photo-fan {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fan-photo {
    position: absolute;
    width: 72%;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(0,0,0,0.35);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease, box-shadow 0.4s ease;
    transform: rotate(var(--fan-rot, 0deg)) translateX(var(--fan-x, 0px));
    z-index: var(--fan-z, 1);
  }

  .fan-photo img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(55%); transition: filter 0.4s ease; }

  .fan-photo:hover { filter: none; }
  .fan-photo:hover img { filter: grayscale(20%); }

  .fan-photo.active {
    transform: rotate(0deg) translateX(0);
    z-index: 10;
    box-shadow: 0 18px 40px rgba(0,0,0,0.5);
    cursor: default;
  }
  .fan-photo.active img { filter: none; }

  .fan-photo:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .reveal.is-visible { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; scroll-snap-type: none; }
    .fan-photo { transition: filter 0.3s ease; }
  }

  footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 60px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    scroll-snap-align: none;
  }
  footer a { color: var(--amber); text-decoration: none; }

  @media (max-width: 760px) {
    .chapter { min-height: 0; padding: 40px 0; }
    .chapter-inner,
    .chapter:nth-of-type(even) .chapter-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
    }
    .chapter-media { order: -1; }
    .fan-photo { width: 82%; }
    header.masthead { padding-top: 36px; }
  }

  a:focus-visible, button:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-grid">
    <div>
      <div class="callsign">{{ basics.location.city }}, {{ basics.location.country }}</div>
      <h1 class="name">{{ basics.name }}</h1>
      <p class="role">{{ basics.label }}</p>
      <div class="meta-row">
        <a href="resume.html" class="resume-jump">Jump to résumé →</a>
        {% if basics.email %}<a href="mailto:{{ basics.email }}">{{ basics.email }}</a>{% endif %}
        {% for p in basics.profiles %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.network }}</a>{% endfor %}
      </div>
    </div>
    {% if basics.image %}
    <div class="photo-frame"><img src="{{ basics.image }}" alt="{{ basics.name }}"></div>
    {% endif %}
  </div>
</header>

<nav class="timeline-nav">
  <div class="timeline-track">
    {% for ch in chapters %}
    <button data-target="year-{{ ch.year }}">{{ ch.year }}</button>
    {% endfor %}
  </div>
</nav>

{% if intro %}
<section class="intro reveal wrap-narrow">
  <p>{{ intro }}</p>
</section>
{% endif %}

<main>
  {% for ch in chapters %}
  <section class="chapter reveal" id="year-{{ ch.year }}" data-year="year-{{ ch.year }}">
    <div class="wrap">
      <div class="chapter-inner">
        <div class="chapter-text">
          <div class="chapter-year">{{ ch.year }}</div>
          <h2 class="chapter-title">{{ ch.title }}</h2>
          <p class="chapter-body">{{ ch.text }}</p>
        </div>
        {% if ch.images %}
        <div class="chapter-media">
          <div class="photo-fan">
            {% for img, f in zip(ch.images, ch.fan) %}
            <button
              class="fan-photo{% if loop.first %} active{% endif %}"
              style="--fan-rot: {{ f.rot }}deg; --fan-x: {{ f.x }}px; --fan-z: {{ f.z }};"
              aria-label="View photo {{ loop.index }} of {{ ch.images|length }} for {{ ch.year }}"
              {% if ch.images|length == 1 %}tabindex="-1"{% endif %}
            >
              <img src="{{ img }}" alt="{{ ch.title }} — photo {{ loop.index }}" loading="lazy">
            </button>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endfor %}
</main>

<footer>
  Prefer the short version? <a href="resume.html">View my résumé →</a>
</footer>

<script>
(function () {
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var navEl = document.querySelector('.timeline-nav');
  var chapters = Array.prototype.slice.call(document.querySelectorAll('.chapter'));
  var revealEls = document.querySelectorAll('.reveal');
  var navButtons = document.querySelectorAll('.timeline-track button');
  var track = document.querySelector('.timeline-track');

  function setNavHeight() {
    if (navEl) document.documentElement.style.setProperty('--nav-h', navEl.offsetHeight + 'px');
  }
  setNavHeight();
  window.addEventListener('resize', setNavHeight);

  // Active year highlight
  function setActiveNav(id) {
    navButtons.forEach(function (btn) {
      var isActive = btn.dataset.target === id;
      btn.classList.toggle('active', isActive);
      if (isActive && track) {
        var btnRect = btn.getBoundingClientRect();
        var trackRect = track.getBoundingClientRect();
        track.scrollLeft += (btnRect.left - trackRect.left) - trackRect.width / 2 + btnRect.width / 2;
      }
    });
  }

  // Click-to-jump on timeline
  var isProgrammaticScroll = false;

  function waitForScrollSettle(cb) {
    var lastY = window.scrollY;
    var stableFrames = 0;
    function check() {
      var y = window.scrollY;
      if (Math.abs(y - lastY) < 1) {
        stableFrames++;
      } else {
        stableFrames = 0;
      }
      lastY = y;
      if (stableFrames > 6) { cb(); return; }
      requestAnimationFrame(check);
    }
    requestAnimationFrame(check);
  }

  navButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      isProgrammaticScroll = true;
      setActiveNav(btn.dataset.target);
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      waitForScrollSettle(function () { isProgrammaticScroll = false; });
    });
  });

  // Fan photo picker
  document.querySelectorAll('.photo-fan').forEach(function (fan) {
    var photos = fan.querySelectorAll('.fan-photo');
    if (photos.length <= 1) return;
    photos.forEach(function (photo) {
      photo.addEventListener('click', function () {
        photos.forEach(function (p) { p.classList.remove('active'); p.tabIndex = 0; });
        photo.classList.add('active');
      });
    });
  });

  // Active-year tracking: checks actual chapter positions on every scroll
  // frame instead of relying on intersection-threshold events, so a fast
  // scroll can never skip over a chapter without it being detected.
  var scrollTicking = false;

  function updateActiveFromScroll() {
    if (isProgrammaticScroll || !chapters.length) return;
    var navH = navEl ? navEl.offsetHeight : 0;
    var refY = navH + 4;
    var current = chapters[0];
    for (var i = 0; i < chapters.length; i++) {
      if (chapters[i].getBoundingClientRect().top <= refY) {
        current = chapters[i];
      } else {
        break;
      }
    }
    setActiveNav(current.dataset.year);
  }

  window.addEventListener('scroll', function () {
    if (!scrollTicking) {
      scrollTicking = true;
      requestAnimationFrame(function () {
        updateActiveFromScroll();
        scrollTicking = false;
      });
    }
  }, { passive: true });

  updateActiveFromScroll();

  // Fade-in reveal
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
    return;
  }

  var revealObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
  revealEls.forEach(function (el) { revealObserver.observe(el); });
})();
</script>

</body>
</html>
